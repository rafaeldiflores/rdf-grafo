/**
 * Postulador — MCP remoto. Secretos (nunca en este archivo):
 *   npx wrangler secret put GITHUB_CLIENT_ID       # OAuth App de GitHub (login)
 *   npx wrangler secret put GITHUB_CLIENT_SECRET
 *   npx wrangler secret put COOKIE_ENCRYPTION_KEY  # openssl rand -hex 32
 *   npx wrangler secret put VAULT_TOKEN            # fine-grained: solo rdf-vault, Contents RW
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postulador-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // No son secretos: el repo del vault y el único usuario de GitHub autorizado (id numérico).
    "VAULT_REPO": "rafaeldiflores/rdf-vault",
    "ALLOWED_GITHUB_ID": "143029098"
  },
  "migrations": [{ "new_sqlite_classes": ["PostuladorMCP"], "tag": "v1" }],
  "durable_objects": {
    "bindings": [{ "class_name": "PostuladorMCP", "name": "MCP_OBJECT" }]
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "7ff0cd547b77408bae1995936db5bfb5" }],
  "browser": { "binding": "BROWSER" },
  // Logs sin contenidos: el código no registra entradas ni salidas de herramientas.
  "observability": { "enabled": true },
  "dev": { "port": 8788 }
}
